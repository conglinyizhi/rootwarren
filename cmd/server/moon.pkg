import {
  "moonbit-community/rabbita/server" @rserver,
  "hackwaly/moonback",
  "hackwaly/moonback/middlewares/unstable_static" @static,
  "moonbitlang/async",
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/http" @http,
  "moonbitlang/core/argparse" @argparse,
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "conglinyizhi/mbt-mdwiki" @lib,
  "conglinyizhi/mbt-mdwiki/app" @app,
}

supported_targets = "native+wasm"

pkgtype(kind: "executable")
